{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "smogon-tiers": "npx tsx scripts/fetch-smogon-tiers.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/split-learnsets.ts",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 next build",
    "cf:build": "tsx scripts/split-learnsets.ts && cross-env NODE_OPTIONS=--max-old-space-size=8192 opennextjs-cloudflare build && node scripts/remove-large-assets.mjs && node scripts/copy-static-pages.mjs",
    "start": "next start",
    "lint": "next lint",
    "build:data": "node --import tsx ./scripts/build-pokemon.ts && node --import tsx ./scripts/build-league.ts"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "csv-parse": "^6.1.0",
    "fflate": "^0.8.2",
    "fs-extra": "^11.3.2",
    "lodash": "^4.17.21",
    "lucide-react": "^0.561.0",
    "next": "^15.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.5.2",
    "tsx": "^4.21.0",
    "zod": "^4.1.13"
  },
  "overrides": {
    "cookie": "0.7.0",
    "path-to-regexp": "8.3.0",
    "undici": "7.16.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.14.10",
    "@tailwindcss/postcss": "^4",
    "@types/lodash": "^4.17.21",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.0.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.97.0"
  }
}
